# Copy to env/.env and fill in. scripts/* source this file.

# Planner credentials (set the one your planner uses)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Checkpoints (env/setup.sh downloads them here by default)
PI05_CHECKPOINT_PATH=${RS_ROOT}/checkpoints/RLinf-Pi05-LIBERO-130-fullshot-SFT
SAM3_CHECKPOINT_PATH=${RS_ROOT}/checkpoints/sam3/sam3.pt

LIBERO_TYPE=pro

# Ports of the real model services (proxies pick free ports per run)
VLA_PORT=9000
SAM3_PORT=9001
MOLMO_PORT=9002
CUDA_DEVICE=0

# Flash only. Molmo2-8B uses its own venv (transformers>=4.57). From the repo root:
#   uv venv --python 3.11 .venv-molmo
#   uv pip install --python .venv-molmo/bin/python -e "third_party/RPent[molmo]" einops
# Download allenai/Molmo2-8B, then set:
# MOLMO_CHECKPOINT_PATH=${RS_ROOT}/checkpoints/Molmo2-8B
# MOLMO_PYTHON=${RS_ROOT}/.venv-molmo/bin/python

# Optional: Hugging Face mirror for slow connections
# HF_ENDPOINT=https://hf-mirror.com
